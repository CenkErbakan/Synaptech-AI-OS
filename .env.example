# SynapTech AI OS — yerel sırlar (repoya commit edilmez)
# Kopyala: copy .env.example .env

# SQL Server 2022 (Docker: synaptech-ai-os-mssql → 127.0.0.1:14333)
MSSQL_SA_PASSWORD=ChangeMe_SynapTech_Os_2026!
DATABASE_URL=sqlserver://localhost:14333;database=SynaptechAiOs;user=sa;password=ChangeMe_SynapTech_Os_2026!;encrypt=false;trustServerCertificate=true

# API
HOST=127.0.0.1
PORT=3101
SYNAPTECH_OWNER_TOKEN=dev-owner-change-me-32chars-minimum!!
SYNAPTECH_SYSTEM_TOKEN=dev-system-change-me-32chars-minimum!
SYNAPTECH_REPO_ROOT=.
KILL_SWITCH_FILE=config/kill-switch.json

# Dashboard → API
SYNAPTECH_API_URL=http://127.0.0.1:3101
NEXT_PUBLIC_SYNAPTECH_API_URL=http://127.0.0.1:3101

# Cursor Cloud Agents API v1 (Faz 4A — anahtar opsiyonel; live varsayılan KAPALI)
# CURSOR_API_KEY=  # Yalnızca backend .env — commit etme, frontend'e koyma
CURSOR_API_BASE_URL=https://api.cursor.com
CLOUD_AGENT_LIVE_ENABLED=false
CURSOR_CLOUD_MODE=mock
# İlk pilot: yalnızca izole test repo. Üretim SynapTech/Subify/Marivo URL eklemeyin.
# CLOUD_AGENT_ALLOWED_REPOS=https://github.com/CenkErbakan/SynapTech-AI-OS-Pilot
CLOUD_AGENT_ALLOWED_REPOS=
# Pilot base ref (main|master). Üzerine yazılmaz; Cursor cursor/ veya agent/ branch açar.
CLOUD_AGENT_STARTING_REF=master
# Owner On-Demand kapalı doğruladıysa true (harcama ekranı manuel)
CLOUD_ON_DEMAND_VERIFIED=false
# Entegrasyon testleri: true iken config/kill-switch.json'a yazılmaz (yalnızca DB)
# KILL_SWITCH_SKIP_FILE_MIRROR=false

# Faz 5E — Yerel AI CEO (Ollama). Owner onayı (real_ai_provider_pilot) olmadan açmayın.
# Cloud live / On-Demand kapalı kalmalı.
MODEL_PROVIDER=mock
# LOCAL_LLM_BASE_URL=http://127.0.0.1:11434
# LOCAL_LLM_MODEL=qwen2.5:14b
LOCAL_AI_PILOT=false
# Zamanlanmış AI CEO: off | mock | local — varsayılan off (canlı otomasyon ayrı onay).
SCHEDULER_AI_CEO_MODE=off
SCHEDULER_AI_CEO_MAX_PER_DAY=1
# CEO dışı yerel ajan yürütme: off | mock | local — varsayılan off (sürekli otomasyon yok).
LOCAL_AGENT_EXECUTION_MODE=off
LOCAL_AGENT_EXECUTION_MAX_PER_DAY=4
LOCAL_AGENT_PER_AGENT_MAX_PER_DAY=6
LOCAL_AGENT_TICK_MAX=2
# Kontrollü otonomi tick (CEO sonrası ajan pass): off | mock | local — varsayılan off.
CONTROLLED_AUTONOMY_MODE=off
CONTROLLED_AUTONOMY_MAX_RETRIES=2
# GitHub yazma: off | mock | live. live + grant + token ile yalnızca ai/* ve Draft PR.
GITHUB_WRITE_MODE=off
# Fine-grained PAT veya GitHub App installation token. Sohbete yapıştırma, commit etme.
# Oluştur: https://github.com/settings/personal-access-tokens
# Repository: yalnızca ilgili repolar. Permissions: Contents Read and write, Pull requests Read and write, Metadata Read.
# Admin / delete / workflows verme. main/master yazılmaz.
# GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com
# Müşteri e-posta: off | mock | live. live olsa bile ajan otomatik göndermez; Owner execute + consent.
EMAIL_OUTREACH_MODE=off
# SMTP_HOST=smtp.ornek.com
# SMTP_PORT=587
# SMTP_FROM=ops@ornek.com
# SMTP_USER=
# SMTP_PASSWORD=
# Yerel operasyon: kuyruk tavanı ve CEO boşta bekleme (ücretli kota değil).
LOCAL_OPS_OPEN_TASK_CAP=48
LOCAL_OPS_CEO_MIN_INTERVAL_MS=1800000
# Yerel Qwen günlük 2/8 kota yok (T-P5E penceresi açıkken pencere limitleri geçerli).
LOCAL_OPS_UNLIMITED_DAILY=true
# Ajan repo araçları: off | mock | read_only — Owner onayı olmadan read_only açma.
AGENT_REPO_TOOLS_MODE=off
# Sandbox: off | mock | isolated — isolated yalnızca allow-list + temp kopya.
AGENT_SANDBOX_MODE=off
